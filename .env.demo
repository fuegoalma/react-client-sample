# The published demo. Loaded by `vite build --mode demo`.
#
# The API URL is deliberately an unresolvable https host. The mock answers on
# whatever this says (tests/mocks/db.ts reads the same config), and the service
# worker intercepts every request before it leaves the browser — but the scheme
# still has to be https, or the browser would refuse the call as mixed content
# on a page GitHub Pages serves over TLS.
VITE_DEMO=1
VITE_API_BASE_URL=https://api.demo.invalid
VITE_APP_NAME=React Client Sample
