# The published demo. Loaded by `vite build --mode demo`.
#
# The API URL is not a real host: it is the base the mock's handlers are written
# against, and the service worker intercepts those requests before they leave
# the browser. Nothing is ever sent.
VITE_DEMO=1
VITE_API_BASE_URL=http://localhost:8084
VITE_APP_NAME=Photos Client
