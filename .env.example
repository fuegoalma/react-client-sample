# Application
VITE_APP_NAME=React Client Sample

# Base URL of the REST API the client talks to.
# Reachable from the *browser*, so it stays localhost even inside Docker.
VITE_API_BASE_URL=http://localhost:8084

# Host port the client is published on (8084/8085 belong to the API stack).
CLIENT_PORT=8092

# Host port `make preview` serves the built bundle on.
PREVIEW_PORT=8093

# Set to 1 when file watching does not work over your bind mount.
VITE_USE_POLLING=0

# Base URL Playwright hits for the end-to-end suite.
E2E_BASE_URL=http://localhost:8092

# An account that already holds a role-managing role, for the privileged
# end-to-end tests. Roles cannot be granted over HTTP without one, so appoint it
# from the API's console first:
#   make rbac-assign role=super_admin email=<their-email>
# Leave blank and those tests skip rather than pretend to have run.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=secret123
