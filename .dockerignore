# Allow-list: everything is excluded, then the build inputs are added back.
# This keeps the context minimal and independent of whatever else sits in the
# working directory.
*

!package.json
!package-lock.json
!index.html
!vite.config.ts
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!src
!public
!docker

# The demo build starts the suite's own MSW handlers in the browser, so
# `src/main.tsx` names them in a dynamic import that the type checker has to be
# able to resolve. Rollup drops the whole branch from a normal build, and the
# `prod` stage copies only `dist/` — no test code is ever shipped.
!tests

# Never ship build output or secrets, even from the paths above.
**/node_modules
**/dist
.env
