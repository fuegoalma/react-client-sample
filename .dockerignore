# Allow-list: everything is excluded, then the build inputs are added back.
# This keeps the context minimal and independent of whatever else sits in the
# working directory.
*

!package.json
!package-lock.json
!index.html
!vite.config.ts
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!src
!public
!docker

# Never ship build output or secrets, even from the paths above.
**/node_modules
**/dist
.env
